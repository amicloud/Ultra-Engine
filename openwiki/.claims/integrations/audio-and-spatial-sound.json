    {
      "id": "claim_1ab1de3938864c018d435946e74b9a77",
      "statement": "Audio uses a two-stage ownership boundary: the scene-local `AudioControl` queues high-level commands during ECS execution, `Engine::run` translates them after its fixed-step loop using `SoundResource` and sends `MixerCommand`s through a 4096-entry ring buffer, and the CPAL callback owns the mutable tracks, voices, listener state, and source-position map.",
      "evidence": [
        {
          "resource": "repo://engine/src/audio/audio_mixer.rs#L110-L135",
          "version": "repo-lines-v1:sha256:53a389b052f64022c0e69cc789c2d543c7bfa4010171b7f158c41d097bdc2455:"
